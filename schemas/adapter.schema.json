{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slide-system.local/schemas/adapter.schema.json",
  "title": "Slide System Agent Adapter",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "providers", "capabilities", "entrypoint"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "providers": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "capabilities": {
      "type": "object",
      "required": ["read_files", "write_files", "run_commands", "render_browser"],
      "properties": {
        "read_files": { "type": "boolean" },
        "write_files": { "type": "boolean" },
        "run_commands": { "type": "boolean" },
        "render_browser": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "entrypoint": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
