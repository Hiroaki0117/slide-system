{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slide-system.local/schemas/approved-brief.schema.json",
  "title": "Approved Slide Brief",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "purpose", "audience", "cover", "outline", "output", "approved_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "status": { "const": "approved" },
    "purpose": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "cover": {
      "type": "object",
      "required": ["title", "date"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "subtitle": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "organization": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "outline": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "required_materials": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "output": { "type": "object" },
    "approved_at": { "type": "string", "format": "date-time" },
    "approval_message": { "type": "string" }
  },
  "additionalProperties": true
}
