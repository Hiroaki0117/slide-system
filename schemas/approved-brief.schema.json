{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slide-system.local/schemas/approved-brief.schema.json",
  "title": "Approved Slide Brief",
  "type": "object",
  "required": ["schema_version", "run_id", "status", "purpose", "audience", "cover", "outline", "output", "approved_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "status": { "const": "approved" },
    "purpose": { "type": "string", "minLength": 1 },
    "audience": { "type": "string", "minLength": 1 },
    "cover": {
      "type": "object",
      "required": ["title", "date"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "minLength": 1 },
        "subtitle": { "type": ["string", "null"] },
        "author": { "type": ["string", "null"] },
        "organization": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "outline": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "content_contract": {
      "type": "object",
      "required": ["status", "kind", "decision_or_learning_outcome", "research_required", "research_topics", "coverage_items"],
      "properties": {
        "status": { "const": "approved" },
        "kind": { "enum": ["explain", "proposal", "report", "how_to", "training", "comparison", "decision", "reference"] },
        "decision_or_learning_outcome": { "type": "string", "minLength": 1 },
        "research_required": { "type": "boolean" },
        "research_topics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "question", "status", "source_ids"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "question": { "type": "string", "minLength": 1 },
              "status": { "enum": ["verified", "user_supplied", "not_applicable", "unresolved"] },
              "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
            },
            "additionalProperties": false
          }
        },
        "comparison_subjects": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
        "comparison_axes": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverageItem" }
        },
        "coverage_items": {
          "type": "array",
          "items": { "$ref": "#/$defs/coverageItem" }
        }
      },
      "additionalProperties": false
    },
    "required_materials": { "type": "array", "items": { "type": "string" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "output": { "type": "object" },
    "approved_at": { "type": "string", "format": "date-time" },
    "approval_message": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "coverageItem": {
      "type": "object",
      "required": ["id", "label", "requirement", "planned_section", "evidence_terms", "source_ids"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "requirement": { "enum": ["MUST", "SHOULD"] },
        "planned_section": { "type": "string", "minLength": 1 },
        "evidence_terms": { "type": "array", "items": { "type": "string", "minLength": 1 }, "minItems": 1, "uniqueItems": true },
        "source_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
      },
      "additionalProperties": false
    }
  }
}
