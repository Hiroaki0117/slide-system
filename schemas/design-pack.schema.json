{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slide-system.local/schemas/design-pack.schema.json",
  "title": "Slide System Design Pack",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "description", "supports", "entrypoints", "renderer", "font_policy", "fallback_layout"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "description": { "type": "string", "minLength": 1 },
    "supports": {
      "type": "object",
      "required": ["aspect_ratios", "languages", "output_profiles"],
      "properties": {
        "aspect_ratios": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "languages": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "output_profiles": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "entrypoints": {
      "type": "object",
      "required": ["colors", "typography", "spacing", "shapes", "layouts", "components", "qa_rules"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "renderer": {
      "type": "object",
      "required": ["adapter", "template", "font"],
      "properties": {
        "adapter": { "type": "string", "minLength": 1 },
        "template": { "type": "string", "minLength": 1 },
        "font": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "font_policy": {
      "type": "object",
      "required": ["primary", "fallbacks", "verify_loaded_font"],
      "properties": {
        "primary": { "type": "string", "minLength": 1 },
        "fallbacks": { "type": "array", "items": { "type": "string" } },
        "verify_loaded_font": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "fallback_layout": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": false
}
