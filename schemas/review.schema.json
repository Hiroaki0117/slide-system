{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://slide-system.local/schemas/review.schema.json",
  "title": "Slide System Human Review",
  "type": "object",
  "required": ["schema_version", "run_id", "attempt", "reviewer", "result", "good_points", "issues", "reviewed_at"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string" },
    "attempt": { "type": "integer", "minimum": 1 },
    "reviewer": { "type": "string" },
    "result": { "enum": ["accepted", "needs_revision"] },
    "ratings": { "type": "object" },
    "good_points": { "type": "array", "items": { "type": "string" } },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["category", "comment"],
        "properties": {
          "slide_id": { "type": ["string", "null"] },
          "category": { "type": "string" },
          "comment": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "reviewed_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
